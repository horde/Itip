{
    "name": "horde/itip",
    "description": "iTip invitation response library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Itip",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Gunnar Wrobel",
            "email": "p@rdus.de",
            "role": "lead"
        },
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        }
    ],
    "time": "2026-03-16",
    "repositories": [],
    "require": {
        "php": "^7.4 || ^8",
        "horde/icalendar": "^3",
        "horde/mime": "^3",
        "horde/translation": "^3"
    },
    "require-dev": {
        "horde/mail": "^3"
    },
    "suggest": {
        "horde/prefs": "^3"
    },
    "autoload": {
        "psr-0": {
            "Horde_Itip": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Itip\\Test\\": "test/"
        }
    },
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}