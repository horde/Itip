{
    "name": "horde/itip",
    "description": "iTip invitation response library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Itip",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Gunnar Wrobel",
            "email": "p@rdus.de",
            "role": "lead"
        },
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "itip",
        "invitations"
    ],
    "time": "2026-06-30",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "horde/icalendar": "^3 || dev-FRAMEWORK_6_0",
        "horde/mime": "^3 || dev-FRAMEWORK_6_0",
        "horde/translation": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {
        "horde/mail": "^3 || dev-FRAMEWORK_6_0"
    },
    "suggest": {
        "horde/prefs": "^3 || dev-FRAMEWORK_6_0"
    },
    "autoload": {
        "psr-0": {
            "Horde_Itip": "lib/"
        },
        "psr-4": {
            "Horde\\Itip\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Itip\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}